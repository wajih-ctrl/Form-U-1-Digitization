# For Vercel, connect a PRIVATE Blob store in Project > Storage.
# Vercel supplies BLOB_READ_WRITE_TOKEN; do not commit its value.
# For local Blob testing, place the actual value in .env.local.
BLOB_READ_WRITE_TOKEN=

# Optional: isolate production and preview records using distinct prefixes.
U1_STORAGE_PREFIX=u1

# Optional local-only data directory. Ignored when Blob storage is configured.
# U1_DATA_DIR=C:/path/to/persistent-u1-data
